      },
      "repliques": [
        {
          "locuteur": "cmd_ariane_belloc",
          "texte": "Demain, un recon de réserve arrive à l’est. Gardez une sortie pour contourner sa position.",
          "emotion": "neutre"
        }
      ]
    },
    {
      "cle": "releve_alerte_30",
      "declencheur": {
        "type": "journee",
        "journee": 29
      },
      "repliques": [
        {
          "locuteur": "cmd_ariane_belloc",
          "texte": "Demain, une infanterie de réserve arrive au nord. Deux dernières poussées suivront aux journées 34 et 38 sur les accès latéraux. Gardez une réserve mobile.",
          "emotion": "neutre"
        }
      ]
    },
    {
      "cle": "releve_alerte_34",
      "declencheur": {
        "type": "journee",
        "journee": 33
      },
      "repliques": [
        {
          "locuteur": "cmd_ariane_belloc",
          "texte": "Demain, une infanterie arrive par l’accès ouest. Revenez couvrir nos villes sans abandonner le QG.",
          "emotion": "neutre"
        }
      ]
    },
    {
      "cle": "releve_alerte_38",
      "declencheur": {
        "type": "journee",
        "journee": 37
      },
      "repliques": [
        {
          "locuteur": "cmd_ariane_belloc",
          "texte": "Demain, une dernière infanterie arrive par l’accès est. La relève alliée est proche : protégez le QG jusqu’à la fin de la journée 40.",
          "emotion": "neutre"
        }
      ]
    },
    {
      "cle": "releve_alerte_41",
      "declencheur": {
        "type": "journee",
        "journee": 40
      },
      "repliques": [
        {
          "locuteur": "cmd_ariane_belloc",
