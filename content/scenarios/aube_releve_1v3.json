  "dialogueOuverture": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Tenez notre QG pendant quarante journées, ou prenez les trois QG adverses pour terminer plus tôt. Les délégations arrivent du nord, de l’ouest et de l’est. Notre relève entre au début de la journée 41.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Aucun revenu périodique. Les réserves adverses arrivent aux journées 10, 20, 30, 34 et 38, annoncées la veille. Les deux dernières poussées alternent ouest et est. Gardez une réserve mobile et des fonds pour réparer dans nos villes.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Essai tactique : cet affrontement ne modifie pas la progression de campagne. La prise de notre QG ou la perte de toutes nos unités met fin à notre participation.",
      "emotion": "neutre"
    }
  ],
  "dialogueVictoire": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Les accès d’Aube restent partagés. Notre QG a tenu jusqu’à la relève, ou les trois QG adverses ont été pris avant son arrivée : le match est terminé.",
      "emotion": "neutre"
    }
  ],
  "dialogueDefaite": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Le match est terminé. Nous conservons nos relevés et nous reprendrons la préparation avant une autre tentative.",
      "emotion": "neutre"
    }
  ],
