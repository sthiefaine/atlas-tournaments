  "dialogueOuverture": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Siège facultatif : tenez notre QG pendant quarante journées complètes. Trois délégations arrivent par le nord, l’ouest et l’est. Le détachement de relève rejoint notre camp au début de la journée 41 ; il ne crée pas de cinquième camp.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Les budgets sont fixes : aucun revenu périodique. Des réserves adverses finies arrivent aux journées 10, 20 et 30, annoncées la veille. Nos villes permettent de réparer ; gardez des fonds pour cela.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Essai tactique : cet affrontement ne modifie pas la progression de campagne. La prise de notre QG ou la perte de toutes nos unités met fin à notre participation.",
      "emotion": "neutre"
    }
  ],
  "dialogueVictoire": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Quarante journées complètes. Le détachement allié rejoint notre camp au sud, et le match s’achève : les accès d’Aube restent partagés. Il n’y a pas de contre-offensive à jouer dans cet essai.",
      "emotion": "neutre"
    }
  ],
  "dialogueDefaite": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Le match est terminé. Nous conservons nos relevés et nous reprendrons la préparation avant une autre tentative.",
      "emotion": "neutre"
    }
  ],
