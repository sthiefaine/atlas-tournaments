  "dialogueOuverture": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Ces batteries sont attendues au dépôt. Amenez le transport signalé jusqu’à la sortie du nord-est avant la fin de J22. S’il est mis hors jeu, le convoi est perdu.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_tomas_reiner",
      "texte": "Je ferme l’accès du nord. Solveig remonte par le sud-est : deux équipes, mais une seule destination à défendre.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_solveig_tamm",
      "texte": "La grande route vous rapproche de mes véhicules. Le détour ouest est plus long. Choisissez avant de séparer votre escorte.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Nous n’avons pas besoin de prendre leurs QG. Le chargement doit arriver, c’est tout.",
      "emotion": "neutre"
    }
  ],
  "dialogueVictoire": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Le dépôt confirme la livraison. Tomas a perdu le match ; il nous propose pourtant son pont pour la prochaine liaison.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_tomas_reiner",
      "texte": "Les batteries sont bien arrivées. À présent, il faut raccorder nos deux rives. Demain je vous couvre.",
      "emotion": "neutre"
    }
  ],
  "dialogueDefaite": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Le convoi n’est pas arrivé. On reprend avec une escorte resserrée et une route choisie dès le départ.",
      "emotion": "neutre"
    }
  ],
  "scenesDialogue": [
    {
      "cle": "fr03_route",
      "declencheur": {
        "type": "journee",
        "journee": 5
      },
      "repliques": [
        {
          "locuteur": "cmd_ariane_belloc",
          "texte": "Regardez où se trouve le transport. Un détour encore couvert vaut mieux qu’une route libérée trop loin devant lui.",
          "emotion": "neutre"
        }
      ]
    }
