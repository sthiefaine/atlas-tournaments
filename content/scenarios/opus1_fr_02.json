  "dialogueOuverture": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Le transformateur tourne, mais les ateliers manquent de pièces. Deux de ces trois villes suffiraient à organiser les livraisons. Prenez-les et gardez-les ensemble.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_tomas_reiner",
      "texte": "Le même stock doit servir nos deux délégations. Je défends mes accès. Vous devrez choisir entre la boucle du nord et celle du sud.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Le bois au centre protège les fantassins, mais ralentit vos véhicules. Si vous engagez tout au nord, qui empêchera Tomas de reprendre le sud ?",
      "emotion": "neutre"
    }
  ],
  "dialogueVictoire": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Deux villes approvisionnent les ateliers. Un bon de livraison mentionne une voie de service réservée. Ariane vous demande de préparer un convoi : la prochaine étape de la saison reste à venir.",
      "emotion": "neutre"
    }
  ],
  "dialogueDefaite": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Le front nous échappe. Reprenons la préparation : gardez vos fantassins couverts et une réserve pour reprendre les accès.",
      "emotion": "neutre"
    }
  ],
  "scenesDialogue": [
    {
      "cle": "opus1_fr_02_jour5",
      "declencheur": {
        "type": "journee",
        "journee": 5
      },
      "repliques": [
        {
          "locuteur": "cmd_ariane_belloc",
          "texte": "Prendre une ville ne suffit pas : il en faut deux au même moment. Gardez de quoi défendre la première.",
          "emotion": "neutre"
        }
      ]
    }
