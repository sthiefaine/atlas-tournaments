      "declencheur": {
        "type": "etape",
        "etape": 1
      },
      "repliques": [
        {
          "locuteur": "cmd_tomas_reiner",
          "texte": "Première balise activée. La suivante est plus loin : passez par les haies, elles vous couvrent même si les véhicules y avancent moins vite.",
          "emotion": "neutre"
        }
      ]
    },
    {
      "cle": "haies_balise_2",
