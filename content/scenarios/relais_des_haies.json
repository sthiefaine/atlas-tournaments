  "dialogueOuverture": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Voici Tomas, notre partenaire d’exercice. Dans la Ronde, gagner ne veut pas toujours dire battre toutes les unités. Aujourd’hui, vos unités doivent activer trois balises dans l’ordre.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Les forêts offrent une meilleure protection, mais certains véhicules y progressent moins vite.",
      "emotion": "neutre"
    }
  ],
  "dialogueVictoire": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Vous avez suivi la discipline du match : un relais s’active en s’y arrêtant, une ville se capture avec l’ordre Capturer. Toujours lire l’objectif avant d’avancer.",
      "emotion": "joie"
    }
  ],
  "dialogueDefaite": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Un exercice sert à essayer. Relisons les étapes et reprenons tranquillement : votre place dans l’équipe ne dépend pas de cette tentative.",
      "emotion": "neutre"
    }
  ],
  "scenesDialogue": [
    {
