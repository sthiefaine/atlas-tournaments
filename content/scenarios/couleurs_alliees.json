  "dialogueOuverture": [
    {
      "locuteur": "cmd_tomas_reiner",
      "texte": "Tomas vous confie son équipe du Luxembourg pour votre premier match sous les couleurs d’une nation alliée. Son style privilégie la défense.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_tomas_reiner",
      "texte": "Les relais contiennent les relevés d’arbitrage : le tournoi continue, mais quelque chose semble anormal dans leur homologation.",
      "emotion": "neutre"
    }
  ],
  "dialogueVictoire": [
    {
      "locuteur": "cmd_tomas_reiner",
      "texte": "Vous remportez votre première victoire commune. Le relevé mentionne une commission inconnue : la Cinquième Manche. Votre entraînement est derrière vous ; l’histoire de la Ronde commence.",
      "emotion": "joie"
    }
  ],
  "dialogueDefaite": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Le match est perdu, mais personne ne quitte notre équipe. Reprenons le briefing et essayons un autre chemin.",
      "emotion": "doute"
    }
  ],
  "scenesDialogue": [
    {
      "cle": "alliees_relais",
      "declencheur": {
        "type": "etape",
        "etape": 1
      },
      "repliques": [
        {
          "locuteur": "cmd_tomas_reiner",
          "texte": "Premier relevé récupéré. Vous commandez mon équipe aujourd’hui : sa spécialité est la défense, servez-vous-en pour tenir les relais plutôt que pour charger.",
          "emotion": "neutre"
        }
      ]
    },
    {
      "cle": "alliees_anomalie",
      "declencheur": {
        "type": "etape",
        "etape": 2
      },
      "repliques": [
        {
          "locuteur": "cmd_tomas_reiner",
          "texte": "Deuxième relevé. Les chiffres d’arbitrage ne concordent pas avec ceux du Bureau. Terminez le relais, nous lirons le troisième ensemble.",
          "emotion": "doute"
