  "dialogueOuverture": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Prenez puis conservez le radar central et la ville du nord-est avant la fin de J18. Il faut posséder les deux ; prendre le QG adverse ne remplace pas cet objectif.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Le drone observe au-delà des arbres, l’infanterie capture. Avancez après avoir lu la zone visible. Le radar capturé partage ses relevés avec votre camp.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "La station radar émet aussi une IEM à J4 puis toutes les trois journées, rayon deux cases orthogonales. Vos appareils aériens ou marins doivent sortir du rayon avant l’impulsion, ou votre infanterie doit capturer la source.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Normal et difficile gardent le brouillard et ce calendrier. Tomas est plus prudent en difficile ; aucun capteur ne voit secrètement à travers le brouillard.",
      "emotion": "neutre"
    }
  ],
  "dialogueVictoire": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Exercice réussi. Vous pouvez revoir la carte ou poursuivre la formation ; les rappels restent consultables.",
      "emotion": "neutre"
    }
  ],
  "dialogueDefaite": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Reprenez votre placement et l’objectif annoncé. Cette tentative s’arrête, mais vous pouvez recommencer sans perdre les autres exercices.",
      "emotion": "neutre"
    }
  ],
