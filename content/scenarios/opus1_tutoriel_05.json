  "dialogueOuverture": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Prenez le QG de Tomas ou mettez toutes ses unités hors jeu avant la fin de J18. Aucun revenu ni renfort : chaque placement compte.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "La crête sépare deux couloirs. Placez l’artillerie derrière le char : elle tire à distance, mais ne tire pas après avoir bougé et ne riposte pas au contact.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Normal : Tomas engage directement ses patrouilles. Difficile : il protège mieux ses pièces et ses captures. Les dégâts, effectifs et budgets restent identiques.",
      "emotion": "neutre"
    }
  ],
  "dialogueVictoire": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Exercice réussi. Vous pouvez revoir la carte ou poursuivre la formation ; les rappels restent consultables.",
      "emotion": "neutre"
    }
  ],
  "dialogueDefaite": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Reprenez votre placement et l’objectif annoncé. Cette tentative s’arrête, mais vous pouvez recommencer sans perdre les autres exercices.",
