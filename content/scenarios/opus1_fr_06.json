  "dialogueOuverture": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Le crédit est gelé. Pas de revenu aujourd’hui ni les jours suivants. La relève entre au sud au début de J9 : gardez le QG et au moins une unité jusque-là.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_edran_sorel",
      "texte": "Edran Sorel, équipe Méridienne. Je peux faire accélérer votre dossier. Il faudrait me confier l’accès aux relevés.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Ces relevés ne sont pas une caution. Nous tiendrons avec ce que nous avons.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_hadran_ost",
      "texte": "Les règles sont publiées. Huit journées. Sorel par l’ouest, moi par l’est.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Le choix fait après Deux rives, un réseau s’applique ici : une reconnaissance à J2 si vous avez partagé les relevés, ou 1 500 fonds si vous avez gardé la réserve.",
      "emotion": "neutre"
    }
  ],
  "dialogueVictoire": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "La relève est là. Les ateliers ont accepté nos commandes sans la garantie de Sorel.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_edran_sorel",
      "texte": "Une ligne de crédit ne dit pas tout sur une équipe. Je le reconnais.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Une patrouille rentre avec ses batteries vides. On va relever son parcours avant de repartir ; la suite de cette enquête reste à venir.",
      "emotion": "neutre"
    }
  ],
  "dialogueDefaite": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "La ligne n’a pas tenu jusqu’à la relève. Reprenons avec des positions plus proches : notre artillerie doit couvrir les deux accès.",
      "emotion": "neutre"
    }
  ],
  "scenesDialogue": [
    {
      "cle": "fr06_releve",
      "declencheur": {
        "type": "journee",
        "journee": 7
      },
      "repliques": [
        {
          "locuteur": "cmd_ariane_belloc",
          "texte": "Encore deux journées avant l’entrée de la relève. Restez autour du QG ; inutile de poursuivre ceux qui reculent.",
          "emotion": "neutre"
        }
      ]
    }
