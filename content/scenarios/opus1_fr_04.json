  "dialogueOuverture": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Tomas tient le nord, nous le sud. Notre objectif commun est le QG de Solveig à l’est. La victoire et la vision sont partagées ; chaque équipe garde ses fonds.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_tomas_reiner",
      "texte": "Je prends le pont du nord. Laissez-moi de la place à sa sortie. Mon artillerie n’avancera pas aussi vite que les chars.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_solveig_tamm",
      "texte": "Deux ponts ne font pas deux victoires. Si vous vous pressez tous au même endroit, je prendrai l’autre rive.",
      "emotion": "neutre"
    }
  ],
  "dialogueVictoire": [
    {
      "locuteur": "cmd_tomas_reiner",
      "texte": "Le réseau est relié. Je peux faire analyser nos relevés par l’équipe commune. Il faut payer le transport des capteurs : on ne pourra pas tout garder en caisse.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Nous avons assez pour une seule option. Partager les relevés nous apportera une reconnaissance au prochain siège. Garder la réserve nous laissera 1 500 fonds pour le préparer.",
      "emotion": "neutre"
    }
  ],
  "dialogueDefaite": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Nos deux colonnes se sont isolées. Reprenons avec un passage pour chacune et une réserve près du fleuve.",
      "emotion": "neutre"
    }
  ],
  "scenesDialogue": [
    {
      "cle": "fr04_liaison",
