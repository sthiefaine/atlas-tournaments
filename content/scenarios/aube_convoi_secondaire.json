  "dialogueOuverture": [
    {
      "locuteur": "cmd_solveig_tamm",
      "texte": "Notre transport au sud-ouest porte les relevés du convoi. Gardez-le en jeu pendant que nos capteurs prennent le QG du nord-est. Deux ponts nous permettent de choisir notre approche.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_solveig_tamm",
      "texte": "La dotation est fixe, sans revenu périodique. Vous avez quinze journées pour prendre le QG adverse. Une perte du véhicule ou de l’unité qui porte le dossier termine cette tentative.",
      "emotion": "neutre"
    }
  ],
  "dialogueVictoire": [
    {
      "locuteur": "cmd_solveig_tamm",
      "texte": "Le poste reconnaît notre passage et le transport est intact. Solveig peut désormais engager son convoi sur la route d’Aube.",
      "emotion": "neutre"
    }
  ],
  "dialogueDefaite": [
    {
      "locuteur": "cmd_solveig_tamm",
      "texte": "Le contrôle du poste nous échappe. La quête pourra être retentée ; la route principale reste ouverte.",
      "emotion": "neutre"
    }
