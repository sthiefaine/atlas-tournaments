  "dialogueOuverture": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Deux rades, une chaussée d’un pavé de large, et tout le reste est de l’eau. Le port produit et ravitaille : c’est lui qui décide de la largeur du terrain.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_tomas_reiner",
      "texte": "Passe par la chaussée si tu veux te faire compter. Moi, je débarque là où tu ne regardes pas.",
      "emotion": "doute"
    }
  ],
  "dialogueVictoire": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Barge, plage, quatre journées de capture. Le match se gagnait par la mer, et il s’est gagné par la mer.",
      "emotion": "joie"
    }
  ],
  "dialogueDefaite": [
    {
      "locuteur": "cmd_tomas_reiner",
      "texte": "Tu as passé le match à défendre un pont pendant que mes barges tournaient autour. Reviens avec une rade tenue.",
      "emotion": "triomphe"
    }
  ],
  "scenesDialogue": [
    {
      "cle": "rades_premier_contact",
      "declencheur": {
        "type": "premier_combat"
      },
      "repliques": [
        {
          "locuteur": "cmd_ariane_belloc",
          "texte": "Sur la chaussée, une seule unité passe à la fois. Ce qui la couvre depuis la rive compte autant qu’elle.",
          "emotion": "neutre"
        }
      ]
    },
    {
      "cle": "rades_capture_adverse",
      "declencheur": {
        "type": "capture",
        "camp": 1
      },
      "repliques": [
        {
          "locuteur": "cmd_tomas_reiner",
          "texte": "Un îlot de plus. Les villes du large rapportent comme les autres, et personne ne les surveille.",
          "emotion": "joie"
        }
      ]
    }
