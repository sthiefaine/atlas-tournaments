  "dialogueOuverture": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Le transformateur alimente les ateliers de la vallée. Prenez le QG qui commande ses accès avant J24. Je reste à la radio ; les décisions sont à vous.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_tomas_reiner",
      "texte": "Ma délégation tient l’autre rive. Deux ponts, deux passages à défendre. Je ne vous offrirai pas le réseau parce que nous nous connaissons.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Les villes financent les renforts. Gardez une infanterie pour la prise du QG : le char peut ouvrir le chemin, pas signer à votre place.",
      "emotion": "neutre"
    }
  ],
  "dialogueVictoire": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Le transformateur est à vous. Ses ateliers réclament maintenant des pièces et des équipes de maintenance. Gagner un site était la première étape ; le faire fonctionner sera la suivante.",
      "emotion": "neutre"
    }
  ],
  "dialogueDefaite": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Le front nous échappe. Reprenons la préparation : gardez vos fantassins couverts et une réserve pour reprendre les accès.",
      "emotion": "neutre"
    }
  ],
  "scenesDialogue": [
    {
