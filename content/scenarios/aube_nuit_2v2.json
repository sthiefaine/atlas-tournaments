  "dialogueOuverture": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Tomas couvre la route sud, nous prenons celle du nord. Hadran et Solveig forment la coalition adverse. Prenez leurs deux QG ou mettez leurs deux camps hors jeu. La nuit vient après quatre journées ; le brouillard est actif.",
      "emotion": "neutre"
    },
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "Essai tactique : cet affrontement ne modifie pas la progression de campagne. La prise de notre QG ou la perte de toutes nos unités met fin à notre participation.",
      "emotion": "neutre"
    }
  ],
  "dialogueVictoire": [
    {
      "locuteur": "cmd_ariane_belloc",
      "texte": "La voie des archives reste ouverte. Nous pouvons comparer les contrats de stockage aux capacités réellement promises.",
