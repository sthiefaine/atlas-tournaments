# ——— Obligatoires ———————————————————————————————————————————————
# Connexion Postgres (URL interne Coolify en prod)
DATABASE_URL=postgres://postgres:password@localhost:5432/atlas
# Mot de passe du panel admin (/admin)
ADMIN_PASSWORD=change-me
# Secret de signature des sessions admin (openssl rand -hex 32)
AUTH_SECRET=change-me-too
# Secret partagé des endpoints de routine (Authorization: Bearer ...)
CRON_SECRET=change-me-cron
# URL publique du site
SITE_URL=https://atlas.example.com

# ——— Optionnelles ————————————————————————————————————————————————
# Fuseau des échéances de la Dépêche du jour
DEPECHE_TZ=Europe/Paris
# Heure de mise en ligne de la Dépêche (HH:MM, fuseau DEPECHE_TZ)
DEPECHE_HEURE=18:00
# Dossier des copies de sécurité avant migration (volume monté en prod)
BACKUP_DIR=.backups
