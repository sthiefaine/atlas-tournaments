# deps
/node_modules

# next
/.next/
/out/
next-env.d.ts

# env
.env
.env*.local

# misc
.DS_Store
*.tsbuildinfo
npm-debug.log*

# copies de sécurité avant migration
.backups/

# Playwright
/playwright-report/
/test-results/

# fichiers déposés par l'application Claude
/Claude outputs/

# Brouillons de travail : rien de ce qui est ici ne fait partie du dépôt.
/tmp/

# aperçus de cartes générés
/apercus/

# Construction lancée à côté du serveur de développement (next.config.ts)
.next-build

# Les worktrees des agents (isolation des chantiers parallèles)
.claude/worktrees/

# Les dérivés d'une livraison d'asset : le zip reproduit ce que public/ contient
# déjà, et les aperçus pèsent un mégaoctet pour une image qu'on regarde une fois.
# Ce qu'on garde d'une livraison, c'est son README, son atlas et son verdict.
assets/livraisons/**/*.zip
assets/livraisons/**/*.png

# Copies locales pour comparer une réception ; seules les revues sont versionnées.
assets/receptions/*/*/
assets/receptions/*/precedente.json
assets/receptions/*/*.tmp
doc/refonte/atlas-lore.html
